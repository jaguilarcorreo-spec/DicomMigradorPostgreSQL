    // Shortcut actions from list view
    async Task StartAsync(Migration m)  { _actionBusy = true; try { await Worker.StartAsync(m.Id); m.Status = "Running"; } finally { _actionBusy = false; StateHasChanged(); } }
    async Task PauseAsync(Migration m)  { _actionBusy = true; try { await Worker.PauseAsync(m.Id); m.Status = "Paused"; } finally { _actionBusy = false; StateHasChanged(); } }
